# EVA-App TLS verification. Keep aligned with the EVA certificates in use.
# Feedback source used when an EVA version is unknown or outside supported ranges.
DASHBOARD_FEEDBACK_FALLBACK_SOURCE=api

# Only needed when feedback fallback is configured to use MySQL.
EVA_MYSQL_USER=
EVA_MYSQL_PASSWORD=
EVA_MYSQL_DATABASE=db_name
EVA_MYSQL_PORT=32080

# Feature visibility can be controlled independently.
DASHBOARD_ENABLED=true
LIVE_ENABLED=true
STREAMING_ENABLED=true

# Backend uses the selected version tag; Caddy follows latest.
DOCK_ECR_REPOSITORY=ecr.your-region.amazonaws.com/your-ecr-repo
DOCK_VERSION=3.3.0
DOCK_BACKEND_IMAGE=${DOCK_ECR_REPOSITORY}:${DOCK_VERSION}
DOCK_CADDY_IMAGE=${DOCK_ECR_REPOSITORY}:latest

# Hostname users enter in the browser and listener ports.
DOCK_TEST_HOST=your-dock-host.example.com
DOCK_PORT=18080
DOCK_SECURE_PORT=8081

# Relative paths are resolved from the directory containing eva-live.sh.
DOCK_DATA_DIR=data
DOCK_TLS_CERT_FILE=certs/tls.crt
DOCK_TLS_KEY_FILE=certs/tls.key
